NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
VILO_ANTHROPIC_KEY=your-anthropic-api-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Sheets staging (Phase 1d) ────────────────────────────────
# Paste the entire service-account JSON as one line. Get it from:
# Google Cloud Console -> IAM -> Service Accounts -> Keys -> Add Key -> JSON.
# Share your staging Sheet with the service-account email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"…","private_key":"…"}
# Spreadsheet ID from the Sheet URL — the long hash between /d/ and /edit.
SHEETS_STAGING_ID=
# Tab name inside the Sheet. Default "staging" if omitted.
SHEETS_STAGING_TAB=staging
